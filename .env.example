# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/waf_reimbursements?schema=public"

# Auth (NextAuth v5)
AUTH_SECRET="your-secret-key-at-least-32-chars-long"
AUTH_URL="http://localhost:3000"

# Upload
UPLOAD_DIR="uploads"

# OCR (optional - uses mock if not set)
# Anthropic Claude vision (recommended - handles images and PDFs)
ANTHROPIC_API_KEY=""
ANTHROPIC_OCR_MODEL="claude-sonnet-4-6"

# Legacy generic OCR (used only if ANTHROPIC_API_KEY is unset)
OCR_API_KEY=""
OCR_API_URL=""
