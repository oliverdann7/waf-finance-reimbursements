generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role      @default(WORKER)
  city            String    @default("")
  department      String    @default("")
  title           String    @default("")
  defaultCurrency String    @default("TRY")
  monthlyLimit    Float     @default(5000)
  receiptLimit    Float     @default(500)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  churchId        String?
  church          Church?   @relation(fields: [churchId], references: [id])
  expenses        Expense[]
  receipts        Receipt[]
  reports         Report[]

  @@index([churchId])
}

model Church {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  city      String   @default("")
  district  String   @default("")
  address   String   @default("")
  phone     String   @default("")
  email     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  financialReports ChurchMonthlyFinancialReport[]
}

model ChurchMonthlyFinancialReport {
  id              String             @id @default(cuid())
  churchId        String
  month           Int
  year            Int
  status          ChurchReportStatus @default(DRAFT)

  totalTithe           Float  @default(0)
  totalSpecialOfferings Float  @default(0)
  totalIncome          Float  @default(0)

  fundIncome   Float @default(0)
  fundExpenses Float @default(0)
  fundBalance  Float @default(0)

  distributionGC    Float @default(0)
  distributionMENA  Float @default(0)
  distributionWAF   Float @default(0)
  distributionLocal Float @default(0)
  distributionOther Float @default(0)
  distributionTotal Float @default(0)

  bankBalance         Float  @default(0)
  priorMonthBalance   Float  @default(0)
  totalDeposits       Float  @default(0)
  expectedBalance     Float  @default(0)
  variance            Float  @default(0)
  reconciliationNotes String @default("")

  adminNotes     String    @default("")
  submissionDate DateTime?
  approvalDate   DateTime?
  submittedById  String?
  approvedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  church             Church                 @relation(fields: [churchId], references: [id], onDelete: Cascade)
  titheOfferingDetails TitheOfferingDetail[]
  attachments          ChurchReportAttachment[]

  @@unique([churchId, month, year])
  @@index([churchId])
  @@index([status])
}

model TitheOfferingDetail {
  id        String    @id @default(cuid())
  reportId  String
  type      String
  donorName String
  amount    Float
  date      DateTime?
  notes     String    @default("")

  report ChurchMonthlyFinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ChurchReportAttachment {
  id           String   @id @default(cuid())
  reportId     String
  originalName String
  filePath     String
  fileType     String
  fileSize     Int
  section      String   @default("other")
  uploadDate   DateTime @default(now())

  report ChurchMonthlyFinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ChurchDistributionConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  percentage  Float
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Report {
  id                String       @id @default(cuid())
  month             Int
  year              Int
  status            ReportStatus @default(DRAFT)
  totalRequested    Float        @default(0)
  totalReimbursable Float        @default(0)
  adminComments     String       @default("")
  submissionDate    DateTime?
  approvalDate      DateTime?
  paymentDate       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  userId            String
  expenses          Expense[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Expense {
  id                 String        @id @default(cuid())
  date               DateTime
  merchant           String
  description        String        @default("")
  category           String
  amount             Float
  currency           String        @default("TRY")
  exchangeRate       Float         @default(1)
  amountInTRY        Float
  reimbursableAmount Float
  notes              String        @default("")
  status             ExpenseStatus @default(PENDING)
  adminComment       String        @default("")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String
  reportId           String
  report             Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipts           Receipt[]
}

model Receipt {
  id                  String    @id @default(cuid())
  originalName        String
  filePath            String
  fileType            String
  fileSize            Int
  extractedText       String    @default("")
  parsedDate          DateTime?
  parsedMerchant      String    @default("")
  parsedAmount        Float?
  parsedCurrency      String    @default("")
  parsedPaymentMethod String    @default("")
  suggestedCategory   String    @default("")
  confidenceScore     Float     @default(0)
  uploadDate          DateTime  @default(now())
  userId              String
  expenseId           String?
  expense             Expense?  @relation(fields: [expenseId], references: [id])
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReimbursementRule {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  type        String
  value       Float
  unit        String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  WORKER
  TREASURER
  ADMIN
  SUPER_ADMIN
  CHURCH_TREASURER
  CHURCH_PASTOR
  CHURCH_USER
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChurchReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}
